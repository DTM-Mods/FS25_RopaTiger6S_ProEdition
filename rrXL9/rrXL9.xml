         Only the main color theme and group #1 are offered on this machine; its other parts keep their stock colors. Each recolors every part in that stock color; the first entry
         ('Stock') keeps the original shades. Left out on purpose: hoses and the copper part. -->
    <!-- Main Color Theme: yellow (the main color option, listed first in the shop) -->
    <baseColorConfigurations title="Main Color Theme" useDefaultColors="true" price="0" defaultColorMaterialTemplateName="calibratedPaint">
        <baseColorConfiguration name="Stock" materialTemplateName="ROPA_YELLOW" isDefault="true"/>
        <baseColorConfiguration materialTemplateName="ROPA_BLUE"/>
        <baseColorConfiguration materialTemplateName="ROPA_GRAY"/>
        <baseColorConfiguration materialTemplateName="ROPA_GRAY1"/>
        <baseColorConfiguration materialTemplateName="ROPA_DARKGRAY"/>
        <baseColorConfiguration materialTemplateName="ROPA_BLACK1"/>
        <baseColorConfiguration materialTemplateName="ROPA_BLACK2"/>
    </baseColorConfigurations>

    <designColorConfigurations title="Color Group #1" useDefaultColors="true" price="0" defaultColorMaterialTemplateName="calibratedPaint">
        <designColorConfiguration name="Stock" materialTemplateName="ROPA_BLACK1" isDefault="true"/>
        <designColorConfiguration materialTemplateName="ROPA_YELLOW"/>
        <designColorConfiguration materialTemplateName="ROPA_BLUE"/>
        <designColorConfiguration materialTemplateName="ROPA_GRAY"/>
        <designColorConfiguration materialTemplateName="ROPA_GRAY1"/>
        <designColorConfiguration materialTemplateName="ROPA_DARKGRAY"/>
        <designColorConfiguration materialTemplateName="ROPA_BLACK2"/>
