        <!-- Main Color Theme: yellow -->
        <paint colorScale="1.11 0.616 0" configName="baseColor" colorOnly="true" skipFirst="true"/>
        <paint colorScale="0.9914 0.687 0" configName="baseColor" colorOnly="true" skipFirst="true"/>
    </proPaint>

